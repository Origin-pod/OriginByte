---
import { getCollection, type CollectionEntry } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import SiteFooter from '../../components/chrome/SiteFooter.astro';
import BookCover from '../../components/BookCover.astro';

export async function getStaticPaths() {
  const books = await getCollection('library');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

interface Props {
  book: CollectionEntry<'library'>;
}

const { book } = Astro.props;
const data = book.data;
const progress = data.progress ?? 0;
const pages = data.pages ?? 100;
const start = data.pageLabel?.match(/\d+/)?.[0] ?? String(Math.max(1, Math.round((progress / 100) * pages)));
const citation = `${data.author}. ${data.title}.`;
const shelf = data.category[0].toUpperCase() + data.category.slice(1);
---

<IndexLayout title={data.title} page="book" description={`${data.title} by ${data.author}`}>
  <main class="col page" id="content">
    <div class="crumb" data-r>
      <a href="/library/">Library</a> / <a href="/library/">{shelf}</a> / {data.title}
    </div>
    <section class="detail">
      <a class="book bigbook" href="#reader" data-r>
        <BookCover cover={data.cover} author={data.author} title={data.title} ornament={data.ornament} />
      </a>
      <div class="info">
        <h1 data-r>{data.title}</h1>
        <p class="by" data-r>{data.byline ?? data.author}</p>
        <div class="facts" data-r>
          <div><span>pages</span><b>{data.pages ?? '—'}</b></div>
          <div><span>shelf</span><b>{shelf}</b></div>
          <div><span>format</span><b>PDF</b></div>
          <div><span>added</span><b>{data.added ?? '—'}</b></div>
        </div>
        {data.progress != null && (
          <div class="pbar" data-r>
            <span>{data.pageLabel ?? `${data.progress}%`}</span>
            <div class="prog"><i style={`width:${data.progress}%`}></i></div>
            <span>{data.progress}%</span>
          </div>
        )}
        <div class="acts" data-r>
          <a class="btn acc mag" href="#reader">Continue reading <span class="arr">→</span></a>
          {data.fileUrl ? (
            <a class="btn ghost mag" href={data.fileUrl}>↓ PDF</a>
          ) : (
            <button class="btn ghost mag" type="button" data-empty-pdf>↓ PDF</button>
          )}
          <button class="btn ghost mag" id="cite" type="button">Copy citation</button>
        </div>
        {data.highlights.length > 0 && (
          <div class="hls" data-r>
            <h3>My highlights · {data.highlights.length}</h3>
            {data.highlights.map((h) => (
              <blockquote>
                {h.quote}
                {h.note && <span>{h.note}</span>}
              </blockquote>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="reader" id="reader" data-r data-start={start} data-pages={pages} data-cite={citation}>
      <div class="rbar">
        <a class="ib" href="/library/" title="Back to library">←</a>
        <span class="t">{data.title}</span>
        <span class="sp"></span>
        <button class="ib hide" type="button" title="Search">⌕</button>
        <button class="ib" id="prev" type="button" aria-label="Previous pages">‹</button>
        <span class="pg"><span id="pn">{start}</span> / {pages}</span>
        <button class="ib" id="next" type="button" aria-label="Next pages">›</button>
        <button class="ib hide" type="button">−</button>
        <span class="pg hide">110%</span>
        <button class="ib hide" type="button">+</button>
        <button class="ib hide" type="button" title="Fullscreen">⤢</button>
      </div>
      <div class="rbody">
        <div class="thumbs" aria-hidden="true">
          <i data-p="212"></i><i data-p="213"></i><i class="on" data-p={start}></i><i data-p="215"></i><i data-p="216"></i>
        </div>
        <div class="spread" id="spread">
          <div class="leaf l">
            <div class="k">Sample page</div>
            <h4>Placeholder spread</h4>
            <p>This is a design placeholder for the reader. The real view will render each page of the PDF with pdf.js, streamed from object storage a page at a time.</p>
            <p>The file itself is not in git. When <code>fileUrl</code> points at Cloudflare R2, this spread can be replaced by the rendered page.</p>
            <div class="diag"><i></i><i></i><i></i><i></i></div>
            <div class="fn"><span>{data.short ?? data.title}</span><span>{Number(start) - 1}</span></div>
          </div>
          <div class="leaf r">
            <div class="k">Reader behaviour</div>
            <p>Arrow keys turn pages. The page flip is a short tilt that falls back to an instant change when reduced motion is on.</p>
            <p><mark>Progress on this shelf is metadata in the content collection, not an account.</mark></p>
            <p>In dark mode the page takes a warm charcoal tone instead of inverting a PDF, so diagrams keep their colours.</p>
            <p>Opening a book on a phone shows one page at a time.</p>
            <div class="fn"><span>{shelf}</span><span id="pn2">{start}</span></div>
          </div>
        </div>
      </div>
      <div class="rfoot">
        <span>{data.fileUrl ? 'linked from object storage' : 'PDF not uploaded yet · fileUrl is empty'}</span>
        <span>← → turn pages</span>
      </div>
    </section>
    <SiteFooter />
  </main>
</IndexLayout>
