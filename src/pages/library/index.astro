---
import IndexLayout from '../../layouts/IndexLayout.astro';
import SiteFooter from '../../components/chrome/SiteFooter.astro';
import { GOODREADS_URL, library, type ReadingStatus } from '../../data/library';

const groups: { id: ReadingStatus; label: string }[] = [
  { id: 'reading', label: 'Reading' },
  { id: 'read', label: 'Read' },
  { id: 'want-to-read', label: 'Want to read' },
];

const byStatus = (id: ReadingStatus) => library.filter((book) => book.status === id);
const shown = groups.filter((group) => byStatus(group.id).length > 0);
const labelOf = (book: (typeof library)[number]) => (book.author ? `${book.title} — ${book.author}` : book.title);
---

<IndexLayout title="Library" page="book" description="A reading list. Names, and an author when there is one.">
  <main class="col page" id="content">
    <header class="ph" data-r>
      <div class="eyebrow">05 — Library</div>
      <h1>The library.</h1>
      <p class="lede">Titles and authors, grouped by what is open, finished, or waiting. Pulled from Goodreads when the site builds.</p>
      <p class="metalink"><a href={GOODREADS_URL} target="_blank" rel="noopener noreferrer">on Goodreads <span class="arr">↗</span></a></p>
    </header>

    <div class="controls" data-r>
      <div class="search">
        <label class="sbox">⌕<input data-search placeholder="Search the shelf" aria-label="Search the shelf"><span class="kbd">/</span></label>
      </div>
      <div class="chips" data-filter="#shelf">
        <button aria-pressed="true" data-v="all">All <span class="n">{library.length}</span></button>
        <button data-v="reading">Reading <span class="n">{byStatus('reading').length}</span></button>
        <button data-v="read">Read <span class="n">{byStatus('read').length}</span></button>
        <button data-v="want-to-read">Want to read <span class="n">{byStatus('want-to-read').length}</span></button>
      </div>
    </div>
    <p class="empty">Nothing on the shelf matches “<b></b>”.</p>

    <div id="shelf">
      {shown.map((group) => (
        <section data-cat={group.id} data-sec data-r>
          <div class="sh"><h2>{group.label}</h2><span class="muted mono">{byStatus(group.id).length}</span></div>
          <div class="list reads">
            {byStatus(group.id).map((book) => {
              const inner = (
                <>
                  <span class="t">{book.title}</span>
                  {book.author && <span class="d">{book.author}</span>}
                </>
              );
              return book.fileUrl ? (
                <a class="row" href={book.fileUrl} title={book.title} data-s={labelOf(book)}>{inner}</a>
              ) : (
                <div class="row" title={book.title} data-s={labelOf(book)}>{inner}</div>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter />
</IndexLayout>
