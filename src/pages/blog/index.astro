---
import { getCollection } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import SiteFooter from '../../components/chrome/SiteFooter.astro';
import { estimateMinutes, writingMeta } from '../../data/writing';

const posts = (await getCollection('blog'))
  .map((post) => {
    const meta = writingMeta[post.id];
    const date = post.data.date ? new Date(post.data.date) : undefined;
    return {
      post,
      meta,
      date,
      year: date ? date.getFullYear() : 0,
      minutes: estimateMinutes(post.body ?? ''),
    };
  })
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

const featured = posts.find((p) => p.meta?.featured) ?? posts[0];
const years = [...new Set(posts.map((p) => p.year))];

const day = (date?: Date) =>
  date
    ? date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })
    : '';
const monthYear = (date?: Date) =>
  date ? date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : '';
---

<IndexLayout title="Writing" page="writing" description="Long reads about how software draws.">
  <main class="col page" id="content">
    <div class="eyebrow" data-r>04 · Writing</div>
    <h1 class="h1" data-r>Long reads about how <em>software draws.</em></h1>
    <p class="lede" data-r>Essays on rendering, frameworks and engines, usually with something to poke at inside.</p>

    {featured && (
      <a class="featpost" href={`/blog/${featured.post.id}/`} data-r>
        <div>
          <span class="badge hot">Most read</span>
          <h2>{featured.meta?.short ?? featured.post.data.title}</h2>
          <p>{featured.meta?.dek ?? featured.post.data.description}</p>
          <div class="mono muted" style="font-size:12px;margin-top:10px">{monthYear(featured.date)} · {featured.minutes} min</div>
        </div>
        <div aria-hidden="true">
          <div class="pipe"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="pl"><span>parse</span><span>style</span><span>layout</span><span>paint</span><span>comp</span></div>
        </div>
      </a>
    )}

    <div class="chips" style="margin-top:34px" data-r data-filter="#posts">
      <button aria-pressed="true" data-v="all">All</button>
      <button data-v="rendering">Rendering</button>
      <button data-v="frameworks">Frameworks</button>
      <button data-v="engines">Engines</button>
    </div>

    <div id="posts">
      {years.map((year) => (
        <div class="yr" data-r>
          <span>{year || 'Undated'}</span>
          <div class="list">
            {posts.filter((p) => p.year === year).map(({ post, meta, date }) => (
              <a class="row" href={`/blog/${post.id}/`} data-cat={meta?.cat ?? 'meta'} data-s={`${post.data.title} ${meta?.dek ?? ''}`}>
                <span class="t">{meta?.short ?? post.data.title}</span>
                <span class="d">{meta?.dek}</span>
                {meta?.hot && <span class="badge hot">Hot</span>}
                <span class="m">{day(date)}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <form class="subscribe" data-subscribe data-r>
      <label class="sbox"><input type="email" placeholder="you@domain.com" aria-label="Email for new posts"></label>
      <button class="btn mag" type="submit">Get new essays</button>
      <a class="btn ghost mag" href="/rss.xml">RSS</a>
    </form>
    <SiteFooter />
  </main>
</IndexLayout>
