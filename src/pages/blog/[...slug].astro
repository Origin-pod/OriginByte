---
import { getCollection, render } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import SiteFooter from '../../components/chrome/SiteFooter.astro';
import StageExplorer from '../../components/StageExplorer.astro';
import { estimateMinutes, writingMeta } from '../../data/writing';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const meta = writingMeta[post.id];
const date = post.data.date ? new Date(post.data.date) : undefined;
const minutes = estimateMinutes(post.body ?? '');
const showExplorer = post.id === '2025-07-02-from-html-to-pixel';
const others = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => (b.data.date ? +new Date(b.data.date) : 0) - (a.data.date ? +new Date(a.data.date) : 0));
const next = others[0];
const pretty = date
  ? date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : '';
const catLabel = meta?.cat === 'rendering' ? 'Rendering' : meta?.cat === 'frameworks' ? 'Frameworks' : meta?.cat === 'engines' ? 'Engines' : 'Notes';
---

<IndexLayout title={post.data.title} page="post" description={meta?.dek ?? post.data.description ?? post.data.title}>
  <div class="progress" id="prog"></div>
  <main class="col page" id="content">
    <div class="crumb eyebrow" data-r>
      <a href="/blog/">Writing</a> · <span>{pretty}</span> · <span>{catLabel}</span>
    </div>
    <h1 class="ph1" data-r>{meta?.short ?? post.data.title}</h1>
    <p class="dek" data-r>{meta?.dek ?? post.data.description}</p>
    <div class="by" data-r>
      <span class="av">S</span>
      <span><b>Sheetal Singh</b></span>
      <span class="muted mono" style="font-size:12px">{minutes} min read</span>
      <button class="btn ghost mag" style="height:30px;font-size:13px;margin-left:auto" id="cp" type="button">Copy link</button>
    </div>
    <div class="body">
      {showExplorer && <StageExplorer />}
      <div class="post-copy">
        <Content />
      </div>
    </div>
    <div class="endnav" data-r>
      <a class="link" href="/blog/">← All writing</a>
      {next && (
        <a class="btn mag" href={`/blog/${next.id}/`}>
          Next: {writingMeta[next.id]?.short ?? next.data.title} <span class="arr">→</span>
        </a>
      )}
    </div>
    <SiteFooter />
  </main>
</IndexLayout>

<style>
  .post-copy :global(h1:first-child) { display: none; }
  .post-copy :global(h2) {
    font: 400 30px/1.1 var(--serif);
    color: var(--ink);
    margin: var(--space-7) 0 var(--space-3);
    letter-spacing: -0.01em;
  }
  .post-copy :global(h3) { color: var(--ink); margin: var(--space-6) 0 var(--space-2); }
  .post-copy :global(p) { margin-bottom: var(--space-5); }
  .post-copy :global(a) { color: var(--ink); background: linear-gradient(var(--hair2), var(--hair2)) 0 100% / 100% 1px no-repeat; }
  .post-copy :global(a:hover) { color: var(--acc-txt); }
  .post-copy :global(code) { font: 0.88em var(--mono); background: var(--surface); border-radius: 5px; padding: 1px var(--space-1); color: var(--ink); }
  .post-copy :global(pre) { background: var(--c-black); color: #d7d7d2; border-radius: 12px; padding: var(--space-4); overflow: auto; margin: var(--space-5) 0; }
  .post-copy :global(pre code) { background: none; padding: 0; color: inherit; }
  .post-copy :global(blockquote) { border-left: 2px solid var(--acc); margin: var(--space-4) 0; padding: var(--space-1) 0 var(--space-1) var(--space-4); color: var(--txt); }
  .body > .post-copy :global(p:first-of-type)::first-letter {
    font: 400 64px/0.8 var(--serif);
    float: left;
    margin: var(--space-2) var(--space-2) 0 0;
    color: var(--ink);
  }
</style>
