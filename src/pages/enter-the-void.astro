---
import IndexLayout from '../layouts/IndexLayout.astro';
---

<IndexLayout title="Void" page="void" description="speak, friend, and enter." nosurprise={true}>
  <div class="rings" aria-hidden="true">
    <svg viewBox="0 0 1000 1000" id="rings">
      <defs><path id="rp" d="M500 500m-330 0a330 330 0 1 1 660 0a330 330 0 1 1-660 0"/></defs>
      <circle cx="500" cy="500" r="480"/>
      <circle cx="500" cy="500" r="400" stroke-dasharray="2 6"/>
      <circle cx="500" cy="500" r="260"/>
      <g class="sp"><text><textPath href="#rp">SPEAK FRIEND · AND ENTER · SPEAK FRIEND · AND ENTER · SPEAK FRIEND · AND ENTER · </textPath></text></g>
    </svg>
  </div>
  <div class="glow" id="glow"></div>
  <main class="vwrap" id="content">
    <div class="door" id="door">
      <span class="big" id="rn" data-r>🜲</span>
      <h1 data-r>speak, friend, and enter.</h1>
      <p data-r>The sealed notes are not in the public site. The word is checked on the server.</p>
      <form class="pw" id="pw" data-r data-server method="post" action="/api/void" autocomplete="off">
        <input id="pi" name="word" placeholder="the word…" aria-label="Passphrase" type="password">
        <button type="submit">Enter</button>
      </form>
      <div class="reply" id="rp2" role="status"></div>
    </div>
  </main>
  <a class="back" href="/">← back to the light</a>
</IndexLayout>
