---
import { site } from '../../data/site';
---

<footer class="ft">
  <span>© 2026 {site.author} · <a class="link" href={`mailto:${site.email}`}>{site.email}</a></span>
  <span class="r">
    <button class="ssr-dev-indicator" data-ssr-lock type="button" hidden>dev mode</button>
    <span class="mono" style="font-size:12px">{site.city} · <span class="ist">--:--</span> IST</span>
    <a class="ft-rune" data-rune data-ssr-rune href="/enter-the-void/" title="speak, friend">🜲</a>
  </span>
</footer>
