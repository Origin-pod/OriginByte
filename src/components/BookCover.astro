---
interface Props {
  cover: string;
  author: string;
  title: string;
  ornament?: string;
  italic?: boolean;
}

const { cover, author, title, ornament, italic = false } = Astro.props;

const ornaments: Record<string, string> = {
  grid: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><rect x="1" y="1" width="20" height="20" rx="3"/><path d="M1 11h20M11 1v20"/></svg>',
  rings: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="9"/><circle cx="11" cy="11" r="4"/></svg>',
  triangle: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><path d="M2 20L11 2l9 18z"/></svg>',
  waves: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><path d="M2 6c4-4 6 4 9 0s6 4 9 0M2 12c4-4 6 4 9 0s6 4 9 0M2 18c4-4 6 4 9 0s6 4 9 0"/></svg>',
  squares: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="currentColor"><rect x="2" y="2" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/><rect x="16" y="16" width="5" height="5"/></svg>',
  star: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><path d="M11 2v18M2 11h18M5 5l12 12M17 5L5 17"/></svg>',
  ellipses: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><ellipse cx="11" cy="11" rx="9" ry="4"/><ellipse cx="11" cy="11" rx="4" ry="9"/></svg>',
  target: '<svg class="orn" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor"><rect x="3" y="3" width="16" height="16" rx="8"/><rect x="7" y="7" width="8" height="8" rx="4"/></svg>',
};
const mark = ornament ? ornaments[ornament] : '';
---

<div class={`cover cv-${cover}`}>
  {mark && <Fragment set:html={mark} />}
  <span class="a">{author}</span>
  <b>{italic ? <i>{title}</i> : title}</b>
</div>
